{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "update_progress", "notify_popup", "pet"],
  "remote": {
    "urls": [
      "https://fanmai.synology.me:8007",
      "http://localhost:5000",
      "http://127.0.0.1:5000"
    ]
  },
  "permissions": [
    "core:default",
    "notification:default",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "allow-notify",
    "allow-open-local-folder",
    "allow-open-local-file",
    "allow-get-app-version",
    "allow-notify-popup-resize",
    "allow-notify-popup-hide",
    "allow-notify-popup-action",
    "allow-save-bytes",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-get-all-windows",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-scale-factor",
    "core:window:allow-is-visible"
  ]
}
